{
  "hooks": [
    {
      "name": "progress-auto-save",
      "event": "user-completes-topic",
      "description": "Automatically save progress when user marks topic as complete",
      "enabled": true,
      "actions": [
        {
          "type": "update-progress",
          "message": "Great job! Topic marked as complete. Updating your progress..."
        },
        {
          "type": "recalculate-eta",
          "message": "Recalculating estimated completion time..."
        }
      ]
    },
    {
      "name": "learning-streak",
      "event": "user-logs-study-time",
      "description": "Track and celebrate learning streaks",
      "enabled": true,
      "actions": [
        {
          "type": "update-streak",
          "message": "Your learning streak continues! 🔥"
        },
        {
          "type": "milestone-notification",
          "thresholds": [7, 14, 30, 60, 100],
          "message": "🎉 Milestone reached! You're on a {{DAYS}}-day learning streak!"
        }
      ]
    },
    {
      "name": "skill-recommendation",
      "event": "roadmap-progress-milestone",
      "description": "Recommend complementary skills when reaching milestones",
      "enabled": true,
      "milestones": [0.25, 0.5, 0.75],
      "actions": [
        {
          "type": "suggest-skills",
          "message": "You're {{PROGRESS}}% through {{ROADMAP}}. Ready to add complementary skills?"
        }
      ]
    },
    {
      "name": "job-readiness-alert",
      "event": "roadmap-completion",
      "description": "Alert when user is ready for job market",
      "enabled": true,
      "actions": [
        {
          "type": "job-readiness-assessment",
          "message": "🎯 You're job-ready for {{JOB_ROLE}}!"
        },
        {
          "type": "portfolio-guide",
          "message": "Next step: Build portfolio projects and practice interviews"
        }
      ]
    },
    {
      "name": "resource-recommendation",
      "event": "topic-started",
      "description": "Suggest best resources for the topic being learned",
      "enabled": true,
      "actions": [
        {
          "type": "find-resources",
          "message": "Check out these curated resources for {{TOPIC}}"
        }
      ]
    },
    {
      "name": "agent-routing",
      "event": "user-asks-question",
      "description": "Route questions to the best specialized agent",
      "enabled": true,
      "routing": {
        "react|vue|angular|frontend": "01-web-development-specialist",
        "nodejs|python|java|go|backend": "02-backend-systems-architect",
        "ios|android|flutter|mobile|data-scientist|ml": "03-mobile-data-expert",
        "docker|kubernetes|terraform|devops|cloud": "04-devops-cloud-engineer",
        "system-design|security|blockchain|architecture": "05-architecture-security-specialist",
        "product|manager|writing|devrel|qa|ux": "06-leadership-specializations",
        "default": "07-universal-navigator"
      }
    },
    {
      "name": "progress-report",
      "event": "weekly",
      "description": "Weekly learning report and recommendations",
      "enabled": true,
      "schedule": "every-sunday-evening",
      "actions": [
        {
          "type": "generate-report",
          "message": "📋 Your weekly learning report is ready!"
        },
        {
          "type": "suggest-adjustments",
          "message": "Based on your pace, here are adjustments for next week"
        }
      ]
    },
    {
      "name": "knowledge-test",
      "event": "roadmap-phase-complete",
      "description": "Optional knowledge check when phase is completed",
      "enabled": true,
      "actions": [
        {
          "type": "offer-quiz",
          "message": "Test your knowledge with a quick quiz? (optional)"
        }
      ]
    },
    {
      "name": "community-engagement",
      "event": "user-milestone",
      "description": "Encourage community sharing and engagement",
      "enabled": true,
      "milestones": [0.5, 1.0],
      "actions": [
        {
          "type": "share-prompt",
          "message": "Share your progress with the community! 🚀"
        },
        {
          "type": "find-peers",
          "message": "Find and connect with others learning {{ROADMAP}}"
        }
      ]
    },
    {
      "name": "burnout-prevention",
      "event": "low-activity-detected",
      "description": "Gentle reminders and motivation if learning slows down",
      "enabled": true,
      "threshold": "7-days-no-activity",
      "actions": [
        {
          "type": "motivation-message",
          "message": "💪 We miss you! Here's why your learning matters..."
        },
        {
          "type": "easy-task",
          "message": "Start with something small today - you've got this!"
        }
      ]
    },
    {
      "name": "learning-path-optimizer",
      "event": "monthly-review",
      "description": "Optimize learning path based on actual pace",
      "enabled": true,
      "schedule": "first-of-month",
      "actions": [
        {
          "type": "analyze-pace",
          "message": "Analyzing your learning pace..."
        },
        {
          "type": "adjust-recommendations",
          "message": "Updating recommendations based on your actual pace"
        }
      ]
    }
  ],
  "globalSettings": {
    "enableNotifications": true,
    "notificationFrequency": "daily",
    "enableAnalytics": true,
    "analyticsLevel": "detailed",
    "enableMilestoneRewards": true,
    "enableCommunityFeatures": true,
    "privacyLevel": "private-by-default"
  },
  "eventListeners": [
    "user-completes-topic",
    "user-logs-study-time",
    "roadmap-progress-milestone",
    "roadmap-completion",
    "topic-started",
    "user-asks-question",
    "weekly-report",
    "roadmap-phase-complete",
    "user-milestone",
    "low-activity-detected",
    "monthly-review"
  ]
}
